# Cloned repositories and reproduction artifacts.
workspace/*
!workspace/.gitkeep

# Global ~/.gitignore excludes .claude/ (per-user settings in most projects).
# In THIS project, .claude/ is the source of the agent fleet — untrack the
# global rule so agents/ and skills/ ship in the repo.
!.claude/
!.claude/**

# Local overrides — real config with tokens, per-machine tweaks.
config/config.local.yaml
config/rules.local.yaml

# Editor / OS scratch.
.idea/
.vscode/
*.swp
.DS_Store

# Build output (language undecided; keep the common ones out preemptively).
/bin/
/dist/
*.exe
*.test

# Generated dashboard output. Regenerate via `dashboard/generate.sh`.
/dashboard/*.html

# Claude Code cron/scheduled-task lock file — session-local.
.claude/scheduled_tasks.lock
